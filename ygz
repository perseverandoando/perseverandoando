local function updateWalkVisual()
	holdingWalk = mouseHoldingWalk or keyHoldingWalk

	if holdingWalk then
		walkBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
		walkStroke.Color = Color3.fromRGB(0, 255, 150)
	else
		walkBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 48)
		walkStroke.Color = Color3.fromRGB(60, 60, 80)
	end
end

local function setMouseWalk(state)
	mouseHoldingWalk = state
	updateWalkVisual()
end

local function setKeyWalk(state)
	keyHoldingWalk = state
	updateWalkVisual()
end

